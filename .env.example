# Copy this file to .env and fill in your OWN values.
# .env should NEVER be committed to git (it's already in .gitignore).

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_CITY=Kolkata

# Download a model from https://alphacephei.com/vosk/models, unzip it,
# and point this at the extracted folder.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# One or more wake words/names, comma-separated -- any of them wakes
# JARVIS up, so you're not stuck saying "jarvis" specifically.
WAKE_WORDS=jarvis,mira

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
